# Telegram Bitcoin Wallet Bot — every setting, documented (PLAN.md §4).
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# it holds a bot token and, on mainnet, an API key that is shown to you once.

# ---------------------------------------------------------------- which chain
# regtest | bitcoin. Chooses the backend block below, and namespaces every
# byte of state under data/{regtest|bitcoin}/ so the two can never mix.
NETWORK=regtest

# From @BotFather.
TELOXIDE_TOKEN=

# Root of the state tree. One SQLite file per user lives under it.
DATA_DIR=./data

# Comma-separated Telegram ids that may use /mine and see full /status.
BOT_ADMIN_IDS=

# Comma-separated allowlist. Empty means anyone may use the bot (multi-user).
ALLOWED_USER_IDS=

# ------------------------------------------------- regtest (Polar's bitcoind)
# Copy these from Polar's Connect tab for the backend bitcoind node.
REGTEST_RPC_URL=http://127.0.0.1:18443
REGTEST_RPC_USER=polaruser
REGTEST_RPC_PASS=polarpass

# The local payjoin directory and OHTTP relay from docker-compose.payjoin.yml.
# Both must be running before /pj_receive will work on regtest.
REGTEST_PAYJOIN_DIRECTORY=http://localhost:8080
REGTEST_OHTTP_RELAY=http://localhost:3000

# Used when estimatesmartfee has no data, which is every fresh regtest chain.
REGTEST_FALLBACK_FEE_SAT_VB=2

# ------------------------------------------------------- mainnet (BitRPC)
# No local node is run or synced. Auth is the X-API-Key header on every call.
BITRPC_URL=https://bitrpc.thebuidl.xyz

# Created at /dashboard and shown exactly once. Never commit it.
BITRPC_API_KEY=

# Headroom under BitRPC's hard 100 req/min, shared by every user of this bot.
BITRPC_RATE_LIMIT_PER_MIN=90

# The slice of that budget the block emitter may spend, so a sync backlog can
# never starve an interactive /send.
BITRPC_SYNC_BUDGET_PER_MIN=60

# /restore refuses a birthday deeper than this many blocks. At ~30 blocks/min
# the default is already about 5.6 hours of scanning.
MAINNET_MAX_RESCAN_BLOCKS=10000

# Hard sat/vB floor used only when getmempoolinfo is unavailable.
MAINNET_MIN_FEE_SAT_VB=1

# BitRPC does not expose estimatesmartfee, so estimation comes from here.
MAINNET_FEE_API=https://mempool.space/api

MAINNET_PAYJOIN_DIRECTORY=https://payjo.in
MAINNET_OHTTP_RELAY=https://pj.bobspacebind.com

# The bot refuses to start on mainnet unless this is exactly `true`.
MAINNET_I_UNDERSTAND_RISK=false

# ------------------------------------------------------------------ policy
# How long a wallet stays unlocked after a correct PIN.
SESSION_IDLE_TIMEOUT_SECS=600

# How long a fee estimate is reused before it is fetched again.
FEE_CACHE_SECS=60

# Optional per-payment safety cap, in satoshis. Empty means no cap.
# Checked twice: against the amount asked for, and again after `max` has been
# resolved into a number.
MAX_SEND_SATS=
